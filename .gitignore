.venv/
cache/
log/
.env
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
*.pt
*.safetensors
# generated drafts (scripts/readme_draft.py, run_table.py): regenerate from the grid; README.md is the deliverable
/drafts/
# jlens interactive slice pages from examples runs: ~0.5 MB each, regenerate with the examples config
results/**/slices/
examples/**/slices/
# Claude Code: personal settings and their backups; the autonomy window's state and log (.claude/autonomy/)
.claude/settings.local.json
.claude/settings.local.json.*
.claude/autonomy/state.json
.claude/autonomy/log.txt
# review dashboard exports (make review-export); review/marks.jsonl, the hand marks, is tracked
/review/seed-*/
# failed runs' partial dirs (Dan, 27 Oct): kept locally, not committed; jobq pull skips them
results/_failed/
# 48.2 A's probe states (84-286 MB each, over GitHub's 100 MB file limit): kept locally and on the box, not committed
results/x48_enrich/*/states_*.npz
# 49.3's per-token states (80-130 MB each, Muse's over GitHub's 100 MB limit): kept locally and on the box; means_L*.npz committed
results/x49_probe/*/tokens_L*.npz

# jsuite v3 items stay out of the public repo (Redwood asks multi-hop sets not be posted); rebuild: scripts/jsuite_v3.py --name jsuite_v3 --seed 3001
data/tasks_v2/jsuite_v3*_test_chat/
# jsuite v4 items stay out of the public repo as v3 (multi-hop sets not posted); rebuild: scripts/jsuite_v4.py (seed 4001, docs/v4_sha256.txt)
data/tasks_v2/jsuite_v4*_test_chat/
data/tasks_v2/jsuite_v5*_test_chat/
data/sd_v1/facts.jsonl
