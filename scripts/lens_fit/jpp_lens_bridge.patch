+def _bolt_language_model(path: str, device_map: str, attn_implementation: str | None):
+    """bridge-jspace patch (2026-10-25, amendment 46): Nemotron 3.5 Bolt's language model alone (NemotronHPuzzleForCausalLM),
+    built by NVIDIA's own code from the pinned local snapshot (read before use; Zach approved running it), its checkpoint
+    keys mapped onto it, the vision tower left unloaded, sharded by device_map. Bolt's RMSNorm applies its weight in fp32
+    before the downcast (Olmo3RMSNorm's order, not Qwen2's), so its LN rule is Olmo3's; the class shares its name with
+    transformers' NemotronHRMSNorm, so the rule is set here, for this process only."""
+    from transformers.dynamic_module_utils import get_class_from_dynamic_module
+
+    from .lrp import lrp as _lrp
+
+    def special(o):
+        return float(o["__float__"]) if set(o) == {"__float__"} else o
+
+    import json
+
+    raw = json.loads((Path(path) / "config.json").read_text(), object_hook=special)["llm_config"]
+    cfg = get_class_from_dynamic_module("configuration_nemotron_h_puzzle.NemotronHPuzzleConfig", path).from_dict(raw)
+    cls = get_class_from_dynamic_module("modeling_nemotron_h_puzzle.NemotronHPuzzleForCausalLM", path)
+    _lrp._RMSNORM_LRP_FORWARDS["NemotronHRMSNorm"] = _lrp._olmo3_rmsnorm_lrp_forward
+    import os as _os
+    import sys as _sys
+
+    if not _os.environ.get("BJ_SLOW_MOE"):  # bridge-jspace amendment 49 note 3: one sync per MoE layer, same numbers
+        _sys.path.insert(0, "/workspace/bridge-jspace/src")
+        from bridge_jspace.model import _patch_fast_moe
+
+        _patch_fast_moe(cls)
+    return cls.from_pretrained(path, config=cfg, key_mapping={r"^language_model\.backbone\.": "model.", r"^language_model\.": ""},
+                               dtype=t.bfloat16, device_map=device_map, attn_implementation=attn_implementation).eval()
